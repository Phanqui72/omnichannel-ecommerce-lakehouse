yX=0;entryY=0.6;" edge="1" parent="1" source="p131" target="p132"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p154" value="PromQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;dashed=1;strokeColor=#999999;fontColor=#777777;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p133" target="p132"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p155" value="alert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="p133" target="p134"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dataflow" name="2. Luồng dữ liệu chi tiết"><mxGraphModel dx="2200" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1110" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b&gt;Sơ đồ 2 — Luồng dữ liệu chi tiết (Data Flow)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Từ nguồn → Landing → Bronze → Silver → Gold → người dùng · mỗi bước có kiểm tra chất lượng&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1500" height="52" as="geometry"/></mxCell><mxCell id="c12" value="① Data Source" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=15;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="270" height="830" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style='font-size:13px'&gt;Nhanh.vn Open API v3&lt;/b&gt;&lt;br&gt;Đơn hàng &lt;b&gt;mọi kênh&lt;/b&gt; (Shopee, TikTok, Admin) · sản phẩm · combo · danh mục · thương hiệu · kho · tồn kho · phiếu kho&lt;br&gt;&lt;font color='#555555'&gt;Daily · incremental theo updatedAt&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c12"><mxGeometry x="15" y="45" width="240" height="135" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style='font-size:13px'&gt;Shopee Seller Centre&lt;/b&gt;&lt;br&gt;Hiệu quả sản phẩm (phễu traffic → đơn) theo listing × ngày&lt;br&gt;&lt;font color='#555555'&gt;Weekly (CN) · crawl 8 ngày&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c12"><mxGeometry x="15" y="195" width="240" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style='font-size:13px'&gt;Shopee — Đánh giá&lt;/b&gt;&lt;br&gt;File Excel xuất tay từ Seller Centre&lt;br&gt;&lt;font color='#555555'&gt;Weekly (T2) · manual export&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c12"><mxGeometry x="15" y="310" width="240" height="85" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style='font-size:13px'&gt;Manual Excel (nội bộ)&lt;/b&gt;&lt;br&gt;Nhóm SP · SKU → nhóm · &lt;b&gt;Shopee listing ↔ SKU&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;Khi có thay đổi&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c12"><mxGeometry x="15" y="410" width="240" height="95" as="geometry"/></mxCell><mxCell id="c17" value="&lt;i&gt;Roadmap (chưa triển khai)&lt;/i&gt;" style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="c12"><mxGeometry x="15" y="530" width="240" height="22" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style='font-size:13px'&gt;TikTok Partner API&lt;/b&gt;&lt;br&gt;Phí sàn, quảng cáo, traffic" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="c12"><mxGeometry x="15" y="555" width="240" height="60" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style='font-size:13px'&gt;Web scraping — Hasaki&lt;/b&gt;&lt;br&gt;Giá &amp; SP đối thủ (weekly)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="c12"><mxGeometry x="15" y="630" width="240" height="60" as="geometry"/></mxCell><mxCell id="c20" value="Đơn TikTok / Shopee đã được Nhanh gom về → &lt;b&gt;chỉ lấy đơn từ Nhanh&lt;/b&gt; để tránh trùng." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;align=left;spacingLeft=6;" vertex="1" parent="c12"><mxGeometry x="15" y="710" width="240" height="60" as="geometry"/></mxCell><mxCell id="c21" value="② Data Lakehouse" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="1430" height="830" as="geometry"/></mxCell><mxCell id="c22" value="Ingestion · Batch (ELT)" style="swimlane;startSize=28;html=1;rounded=1;arcSize=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;dashed=1;" vertex="1" parent="c21"><mxGeometry x="15" y="45" width="250" height="765" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style='font-size:13px'&gt;Python extractor — Nhanh&lt;/b&gt;&lt;br&gt;Gọi API theo trang · watermark updatedAt · kéo lại 3 ngày" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c22"><mxGeometry x="15" y="40" width="190" height="80" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style='font-size:13px'&gt;Shopee crawler&lt;/b&gt;&lt;br&gt;Session cookie (SSM) · 8 ngày/lần" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c22"><mxGeometry x="15" y="135" width="190" height="60" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style='font-size:13px'&gt;File loader&lt;/b&gt;&lt;br&gt;Excel → JSONL (reviews, manual)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c22"><mxGeometry x="15" y="210" width="190" height="60" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b style='font-size:13px'&gt;Landing zone (MinIO)&lt;/b&gt;&lt;br&gt;JSONL.gz giữ “phong bì”: _source, _entity, _batch_id, _extracted_at, _request&lt;br&gt;&lt;font color='#555555'&gt;source=/entity=/dt=/&amp;lt;batch&amp;gt;.jsonl.gz&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c22"><mxGeometry x="15" y="290" width="220" height="115" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Cách nạp&lt;/b&gt;&lt;br&gt;• Incremental: orders, inventory_bills (updatedAt, re-pull 3 ngày)&lt;br&gt;• Snapshot: products, inventory (daily); danh mục (khi đổi)&lt;br&gt;• Lịch: Nhanh daily 06:00 · Shopee weekly&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color='#b85450'&gt;Hạn chế&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Rate limit API Nhanh → phân trang, retry/backoff&lt;br&gt;• Trạng thái đơn đổi muộn (hoàn 1–3 tuần) → nhiều phiên bản/đơn&lt;br&gt;• Shopee không trả SKU → cần listing map&lt;br&gt;• Crawl tuần trùng 1 ngày → dedup ở Silver&lt;br&gt;• Session Shopee hết hạn → cảnh báo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c22"><mxGeometry x="15" y="425" width="220" height="320" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style='font-size:13px'&gt;Bước ① Nạp Bronze · Bước ② Chuẩn hóa Silver&lt;/b&gt; &lt;font color='#555555'&gt;(Spark batch)&lt;/font&gt;&lt;br&gt;① đọc landing → append nguyên trạng · ② parse, làm sạch, dedup → MERGE (upsert)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;" vertex="1" parent="c21"><mxGeometry x="285" y="45" width="700" height="55" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style='font-size:13px'&gt;Bước ③ Mô hình hóa Gold&lt;/b&gt; &lt;font color='#555555'&gt;(dbt-trino)&lt;/font&gt;&lt;br&gt;chạy sau mỗi lần Silver cập nhật · incremental theo ngày" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;" vertex="1" parent="c21"><mxGeometry x="1005" y="45" width="405" height="55" as="geometry"/></mxCell><mxCell id="c30" value="Bronze — Raw Data" style="swimlane;startSize=28;html=1;rounded=1;arcSize=4;fillColor=#ffe0c2;strokeColor=#c67c2e;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="c21"><mxGeometry x="285" y="115" width="330" height="500" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Object type:&lt;/b&gt; Iceberg tables&lt;br&gt;&lt;b&gt;Tables:&lt;/b&gt; 1 bảng / nguồn-entity&lt;br&gt;bronze.nhanh_orders · nhanh_products · nhanh_combos · nhanh_inventory · nhanh_inventory_bills · nhanh_categories · nhanh_brands · nhanh_depots · shopee_product_performance · shopee_reviews · manual_category · manual_product_category · manual_shopee_listing_map&lt;br&gt;&lt;br&gt;&lt;b&gt;Load:&lt;/b&gt;&lt;br&gt;• Append theo batch (Airflow)&lt;br&gt;• Idempotent theo _batch_id (nạp lại không trùng)&lt;br&gt;&lt;br&gt;&lt;b&gt;Transformations:&lt;/b&gt;&lt;br&gt;• Không đổi payload (giữ nguyên JSON gốc)&lt;br&gt;• + cột _ingested_at, _source, _entity, _batch_id&lt;br&gt;&lt;br&gt;&lt;b&gt;Partition:&lt;/b&gt; dt (ngày landing)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#e0b48a;" vertex="1" parent="c30"><mxGeometry x="12" y="40" width="306" height="445" as="geometry"/></mxCell><mxCell id="c32" value="Silver — Cleaned, Standardized" style="swimlane;startSize=28;html=1;rounded=1;arcSize=4;fillColor=#e6e6e6;strokeColor=#7a7a7a;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="c21"><mxGeometry x="635" y="115" width="350" height="500" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Object type:&lt;/b&gt; Iceberg tables&lt;br&gt;&lt;b&gt;Load:&lt;/b&gt; MERGE INTO (upsert) sau mỗi lần nạp Bronze · compaction định kỳ&lt;br&gt;&lt;br&gt;&lt;b&gt;Transformations:&lt;/b&gt;&lt;br&gt;• Parse JSON, flatten mảng (products[], models[])&lt;br&gt;• Dedup theo khóa:&lt;br&gt;&amp;nbsp;&amp;nbsp;– orders: bản updatedAt mới nhất&lt;br&gt;&amp;nbsp;&amp;nbsp;– performance: batch crawl mới nhất&lt;br&gt;&amp;nbsp;&amp;nbsp;– reviews: mtime mới nhất&lt;br&gt;• Ép kiểu; epoch → giờ VN; chuẩn hóa mã trạng thái / kênh / kho&lt;br&gt;• Tách combo → SKU con&lt;br&gt;• Che PII: hash tên, SĐT, địa chỉ&lt;br&gt;&lt;br&gt;&lt;b&gt;Entity tables:&lt;/b&gt;&lt;br&gt;orders · order_lines · products (SCD2) · combo_items · inventory_snapshot · inventory_bills · product_performance_daily · reviews · category · product_category · shopee_listing_map" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="c32"><mxGeometry x="12" y="40" width="326" height="445" as="geometry"/></mxCell><mxCell id="c34" value="Gold — Business-Ready" style="swimlane;startSize=28;html=1;rounded=1;arcSize=4;fillColor=#fff2b3;strokeColor=#c9a600;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="c21"><mxGeometry x="1005" y="115" width="405" height="500" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Object type:&lt;/b&gt; Iceberg tables (dbt models)&lt;br&gt;&lt;b&gt;Load:&lt;/b&gt; dbt-trino incremental theo ngày · full refresh khi cần&lt;br&gt;&lt;br&gt;&lt;b&gt;Star schema&lt;/b&gt;&lt;br&gt;• Dim: dim_date · dim_product (SCD2) · dim_channel_shop · dim_depot · dim_customer · dim_location&lt;br&gt;• Fact: fct_order_line · fct_inventory_snapshot · fct_inventory_movement · fct_product_funnel · fct_review · fct_demand_forecast&lt;br&gt;&lt;br&gt;&lt;b&gt;Marts&lt;/b&gt;&lt;br&gt;sales_daily · stock_alert · order_sla · return_cancel · review_alert · channel_pnl&lt;br&gt;&lt;br&gt;&lt;b&gt;Business logic&lt;/b&gt;&lt;br&gt;• Nhu cầu ≠ doanh số (cộng lost sales khi hết hàng)&lt;br&gt;• Phân bổ tiền đơn xuống dòng; combo → SKU&lt;br&gt;• Doanh thu thuần = tiền hàng − phí sàn − hoàn/hủy" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#e0c95c;" vertex="1" parent="c34"><mxGeometry x="12" y="40" width="381" height="445" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;✔ Kiểm tra ①&lt;/b&gt;&lt;br&gt;• Số dòng landing = bronze theo _batch_id&lt;br&gt;• Batch nạp lại không sinh trùng&lt;br&gt;• Đủ file cho mọi entity theo lịch" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c21"><mxGeometry x="285" y="630" width="330" height="165" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;✔ Kiểm tra ②&lt;/b&gt;&lt;br&gt;• Khóa unique / not null (order_id, sku, comment_id)&lt;br&gt;• FK: dòng đơn → SP, review → listing → SKU&lt;br&gt;• Đơn hủy không có deliveryAt; tiền dòng ≥ 0&lt;br&gt;• Tồn kho = Σ nhập − Σ xuất (đối soát phiếu kho)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c21"><mxGeometry x="635" y="630" width="350" height="165" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;✔ Kiểm tra ③&lt;/b&gt; (dbt test)&lt;br&gt;• Tổng doanh số Gold = Silver theo ngày/kênh&lt;br&gt;• Fact không mồ côi dim (relationships)&lt;br&gt;• Freshness: dữ liệu mới nhất ≤ 1 ngày&lt;br&gt;• Lỗi → dừng DAG, không publish Gold" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c21"><mxGeometry x="1005" y="630" width="405" height="165" as="geometry"/></mxCell><mxCell id="c39" value="" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;dashed=1;strokeColor=#82b366;endArrow=none;" edge="1" parent="c21" source="c30" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;dashed=1;strokeColor=#82b366;endArrow=none;" edge="1" parent="c21" source="c32" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;dashed=1;strokeColor=#82b366;endArrow=none;" edge="1" parent="c21" source="c34" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="③ Consume" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=15;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1780" y="70" width="300" height="830" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b style='font-size:13px'&gt;Power BI&lt;/b&gt;&lt;br&gt;Đọc marts: sales_daily, stock_alert, order_sla, review_alert&lt;br&gt;&lt;font color='#555555'&gt;Dashboard doanh số kênh, tồn kho, SLA, review&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="c42"><mxGeometry x="15" y="50" width="270" height="115" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b style='font-size:13px'&gt;Mô hình dự báo nhu cầu&lt;/b&gt;&lt;br&gt;Python (Prophet / LightGBM)&lt;br&gt;Đọc Gold → train → ghi dự báo về &lt;b&gt;fct_demand_forecast&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;Batch weekly qua Airflow&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="c42"><mxGeometry x="15" y="270" width="270" height="135" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b style='font-size:13px'&gt;Phân tích ad-hoc&lt;/b&gt;&lt;br&gt;Truy vấn trực tiếp Silver / Gold" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="c42"><mxGeometry x="15" y="510" width="270" height="75" as="geometry"/></mxCell><mxCell id="c46" value="④ Lịch chạy &amp; xử lý lỗi" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=15;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="925" width="2060" height="170" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Lịch chạy (DAG)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;nhanh_daily&lt;/b&gt; (06:00): extract → landing → ① bronze → ② silver → ③ gold&lt;br&gt;• &lt;b&gt;shopee_weekly&lt;/b&gt; (CN 07:00): crawl hiệu quả SP + nạp file review → ① → ② → ③&lt;br&gt;• &lt;b&gt;manual_on_change&lt;/b&gt;: có file Excel mới → landing → ① → ② (cập nhật dim)&lt;br&gt;• &lt;b&gt;forecast_weekly&lt;/b&gt; (T2): đọc Gold → train → ghi fct_demand_forecast&lt;br&gt;• &lt;b&gt;maintenance&lt;/b&gt; (02:00): compaction, xóa snapshot cũ" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="c46"><mxGeometry x="15" y="45" width="780" height="110" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Xử lý muộn &amp; chạy lại&lt;/b&gt;&lt;br&gt;• Đơn đổi trạng thái muộn → kéo lại 3 ngày, MERGE theo updatedAt&lt;br&gt;• Crawl Shopee trùng ngày → giữ batch mới nhất&lt;br&gt;• Review sửa → giữ mtime mới nhất&lt;br&gt;• Backfill theo dt: chạy lại 1 khoảng ngày, kết quả không đổi (idempotent)&lt;br&gt;• Lỗi ở bước nào → dừng các bước sau, gửi cảnh báo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="c46"><mxGeometry x="815" y="45" width="640" height="110" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;━━ luồng dữ liệu&lt;br&gt;┅┅ roadmap (chưa làm)&lt;br&gt;&lt;font color='#82b366'&gt;┅┅&lt;/font&gt; điểm kiểm tra chất lượng&lt;br&gt;&lt;font color='#9673a6'&gt;┅┅&lt;/font&gt; kết quả dự báo ghi ngược&lt;br&gt;①②③ bước xử lý" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=12;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="c46"><mxGeometry x="1475" y="45" width="300" height="110" as="geometry"/></mxCell><mxCell id="c50" value="REST · daily" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1" source="c13" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" value="crawl · weekly" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;" edge="1" parent="1" source="c14" target="c24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c52" value="xlsx · weekly" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="c15" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c53" value="xlsx" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.75;" edge="1" parent="1" source="c16" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c54" value="" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.15;" edge="1" parent="c22" source="c23" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c55" value="" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.15;" edge="1" parent="c22" source="c24" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c56" value="" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=1;entryY=0.15;" edge="1" parent="c22" source="c25" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c57" value="" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="c21" source="c26" target="c30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c58" value="" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="c21" source="c30" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c59" value="" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="c21" source="c32" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c60" value="marts" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="c34" target="c43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c61" value="training data" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="c34" target="c44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c62" value="forecast" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;exitX=0;exitY=0.8;entryX=1;entryY=0.66;" edge="1" parent="1" source="c44" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="ad-hoc SQL" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=block;endFill=1;strokeWidth=2;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="c34" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="steps" name="3. Các bước vận hành"><mxGraphModel dx="1600" dy="960" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s501" value="&lt;b&gt;Sơ đồ 3 — Hệ thống chạy như thế nào (9 bước)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Một vòng chạy hằng ngày: số tròn trên sơ đồ khớp với danh sách bước bên dưới&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1300" height="56" as="geometry"/></mxCell><mxCell id="s502" value="&lt;b&gt;Apache Airflow&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;bấm giờ chạy mỗi ngày 06:00&lt;/font&gt;" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontSize=12;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="690" y="80" width="60" height="60" as="geometry"/></mxCell><mxCell id="s503" value="1" style="ellipse;html=1;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#1f3a68;strokeColor=#ffffff;strokeWidth=2;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="660" y="75" width="28" height="28" as="geometry"/></mxCell><mxCell id="s504" value="Nguồn" style="swimlane;startSize=30;html=1;rounded=1;arcSize=3;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="200" height="380" as="geometry"/></mxCell><mxCell id="s505" value="&lt;b&gt;nhanh.vn&lt;/b&gt;" style="rounded=1;arcSize=20;html=1;fontSize=16;fontColor=#ffffff;fillColor=#e8541e;strokeColor=none;" vertex="1" parent="s504"><mxGeometry x="45" y="45" width="110" height="44" as="geometry"/></mxCell><mxCell id="s506" value="&lt;b&gt;Nhanh.vn&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;đơn · tồn kho&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="s504"><mxGeometry x="0" y="93" width="200" height="36" as="geometry"/></mxCell><mxCell id="s507" value="&lt;b&gt;Shopee&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;hiệu quả SP · review&lt;/font&gt;" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontSize=12;image=data:image/svg+xml,;" vertex="1" parent="s504"><mxGeometry x="72" y="160" width="56" height="56" as="geometry"/></mxCell><mxCell id="s508" value="&lt;b&gt;Excel nội bộ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;danh mục&lt;/font&gt;" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontSize=12;image=https://icons.diagrams.net/assets/files/1/Excel.svg;" vertex="1" parent="s504"><mxGeometry x="78" y="275" width="44" height="56" as="geometry"/></mxCell><mxCell id="s509" value="&lt;b&gt;Python&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;lấy dữ liệu&lt;/font&gt;" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontSize=12;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="290" y="375" width="60" height="60" as="geometry"/></mxCell><mxCell id="s510" value="2" style="ellipse;html=1;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#1f3a68;strokeColor=#ffffff;strokeWidth=2;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="238" y="330" width="28" height="28" as="geometry"/></mxCell><mxCell id="s511" value="&lt;b&gt;MinIO landing&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;file thô JSONL.gz&lt;/font&gt;" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontSize=12;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="470" y="375" width="60" height="60" as="geometry"/></mxCell><mxCell id="s512" value="3" style="ellipse;html=1;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#1f3a68;strokeColor=#ffffff;strokeWidth=2;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="400" y="360" width="28" height="28" as="geometry"/></mxCell><mxCell id="s513" value="&lt;b&gt;Apache Spark&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#555555'&gt;xử lý batch&lt;/font&gt;" style="shape=image;html=1;verticalLabelPosition=bottom;verticalAlign=top;labelBackgroundColor=none;imageAspect=0;aspect=fixed;fontSize=12;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="650" y="375" width="60" height="60" as="geometry"/></mxCell><mxCell id="s514" value="Lakehouse (MinIO + Apache Iceberg)" style="swimlane;startSize=30;html=1;rounded=1;arcSize=3;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="400" height="200" as="geometry"/></mxCell><mxCell id="s515" value="Bronze&lt;br&gt;&lt;font style='font-size:10px'&gt;thô&lt;/font&g