e=8;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;dashed=1;strokeColor=#1f5fbf;fontColor=#1f5fbf;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="s502" target="s521"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="110"/></Array></mxGeometry></mxCell><mxCell id="s545" value="đo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;dashed=1;strokeColor=#999999;fontColor=#777777;exitX=0.5;exitY=0;entryX=0.2;entryY=1;" edge="1" parent="1" source="s527" target="s514"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="648" y="560"/><mxPoint x="880" y="560"/></Array></mxGeometry></mxCell><mxCell id="s546" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;dashed=1;strokeColor=#999999;fontColor=#777777;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s528" target="s527"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s547" value="lỗi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#444444;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="s528" target="s529"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="s548" value="Các bước" style="swimlane;startSize=30;html=1;rounded=1;arcSize=3;fillColor=#e8f0fb;strokeColor=#1f3a68;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="1550" height="130" as="geometry"/></mxCell><mxCell id="s549" value="&lt;b&gt;1.&lt;/b&gt; 06:00 Airflow tự động bắt đầu một lượt chạy (Shopee chạy thêm mỗi Chủ nhật).&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Python gọi API Nhanh, tải số liệu Shopee và đọc file Excel nội bộ.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Lưu nguyên dữ liệu vừa lấy thành file JSONL.gz vào MinIO (vùng landing)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="s548"><mxGeometry x="20" y="38" width="495" height="86" as="geometry"/></mxCell><mxCell id="s550" value="&lt;b&gt;4.&lt;/b&gt; Spark đọc file landing, chép nguyên trạng vào bảng &lt;b&gt;Bronze&lt;/b&gt;.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Spark làm sạch, bỏ trùng, chuẩn hóa → cập nhật bảng &lt;b&gt;Silver&lt;/b&gt;.&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; dbt chạy trên Trino tổng hợp thành bảng &lt;b&gt;Gold&lt;/b&gt; (doanh số, tồn kho, review) rồi kiểm tra số liệu." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="s548"><mxGeometry x="530" y="38" width="495" height="86" as="geometry"/></mxCell><mxCell id="s551" value="&lt;b&gt;7.&lt;/b&gt; Power BI làm mới dashboard từ Gold qua Trino — người dùng xem báo cáo buổi sáng.&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Mỗi tuần, mô hình đọc lịch sử bán từ Gold, dự báo nhu cầu và ghi kết quả ngược lại Gold.&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; Prometheus + Grafana theo dõi mọi bước; bước nào lỗi → gửi cảnh báo Telegram, các bước sau dừng lại." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="s548"><mxGeometry x="1040" y="38" width="495" height="86" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>