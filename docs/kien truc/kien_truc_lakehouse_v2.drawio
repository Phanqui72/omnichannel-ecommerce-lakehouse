<mxfile host="app.diagrams.net"><diagram id="lakehouse-v2" name="Lakehouse v2"><mxGraphModel dx="2200" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1200" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b&gt;Kiến trúc Data Lakehouse — Quản lý thương mại điện tử đa kênh&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#555555'&gt;Batch ELT · Medallion (Bronze → Silver → Gold) · MinIO + Iceberg + Spark + Trino + Airflow&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1500" height="52" as="geometry"/></mxCell><mxCell id="c12" value="① Data Source" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=15;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="270" height="830" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b style='font-size:13px'&gt;Nhanh.vn Open API v3&lt;/b&gt;&lt;br&gt;Đơn hàng &lt;b&gt;mọi kênh&lt;/b&gt; (Shopee, TikTok, Admin) · sản phẩm · combo · danh mục · thương hiệu · kho · tồn kho · phiếu kho&lt;br&gt;&lt;font color='#555555'&gt;Daily · incremental theo updatedAt&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c12"><mxGeometry x="15" y="45" width="240" height="135" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b style='font-size:13px'&gt;Shopee Seller Centre&lt;/b&gt;&lt;br&gt;Hiệu quả sản phẩm (phễu traffic → đơn) theo listing × ngày&lt;br&gt;&lt;font color='#555555'&gt;Weekly (CN) · crawl 8 ngày&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c12"><mxGeometry x="15" y="195" width="240" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b style='font-size:13px'&gt;Shopee — Đánh giá&lt;/b&gt;&lt;br&gt;File Excel xuất tay từ Seller Centre&lt;br&gt;&lt;font color='#555555'&gt;Weekly (T2) · manual export&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c12"><mxGeometry x="15" y="310" width="240" height="85" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b style='font-size:13px'&gt;Manual Excel (nội bộ)&lt;/b&gt;&lt;br&gt;Nhóm SP · SKU → nhóm · &lt;b&gt;Shopee listing ↔ SKU&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;Khi có thay đổi&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c12"><mxGeometry x="15" y="410" width="240" height="95" as="geometry"/></mxCell><mxCell id="c17" value="&lt;i&gt;Roadmap (chưa triển khai)&lt;/i&gt;" style="text;html=1;fontSize=11;fontColor=#666666;align=left;" vertex="1" parent="c12"><mxGeometry x="15" y="530" width="240" height="22" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b style='font-size:13px'&gt;TikTok Partner API&lt;/b&gt;&lt;br&gt;Phí sàn, quảng cáo, traffic" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="c12"><mxGeometry x="15" y="555" width="240" height="60" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b style='font-size:13px'&gt;Web scraping — Hasaki&lt;/b&gt;&lt;br&gt;Giá &amp; SP đối thủ (weekly)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="c12"><mxGeometry x="15" y="630" width="240" height="60" as="geometry"/></mxCell><mxCell id="c20" value="Đơn TikTok / Shopee đã được Nhanh gom về → &lt;b&gt;chỉ lấy đơn từ Nhanh&lt;/b&gt; để tránh trùng." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;align=left;spacingLeft=6;" vertex="1" parent="c12"><mxGeometry x="15" y="710" width="240" height="60" as="geometry"/></mxCell><mxCell id="c21" value="② Data Lakehouse" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="320" y="70" width="1430" height="830" as="geometry"/></mxCell><mxCell id="c22" value="Ingestion · Batch (ELT)" style="swimlane;startSize=28;html=1;rounded=1;arcSize=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;dashed=1;" vertex="1" parent="c21"><mxGeometry x="15" y="45" width="250" height="765" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style='font-size:13px'&gt;Python extractor — Nhanh&lt;/b&gt;&lt;br&gt;Gọi API theo trang · watermark updatedAt · kéo lại 3 ngày" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c22"><mxGeometry x="15" y="40" width="190" height="80" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style='font-size:13px'&gt;Shopee crawler&lt;/b&gt;&lt;br&gt;Session cookie (SSM) · 8 ngày/lần" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c22"><mxGeometry x="15" y="135" width="190" height="60" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style='font-size:13px'&gt;File loader&lt;/b&gt;&lt;br&gt;Excel → JSONL (reviews, manual)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c22"><mxGeometry x="15" y="210" width="190" height="60" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b style='font-size:13px'&gt;Landing zone (MinIO)&lt;/b&gt;&lt;br&gt;JSONL.gz giữ “phong bì”: _source, _entity, _batch_id, _extracted_at, _request&lt;br&gt;&lt;font color='#555555'&gt;source=/entity=/dt=/&amp;lt;batch&amp;gt;.jsonl.gz&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c22"><mxGeometry x="15" y="290" width="220" height="115" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Cách nạp&lt;/b&gt;&lt;br&gt;• Incremental: orders, inventory_bills (updatedAt, re-pull 3 ngày)&lt;br&gt;• Snapshot: products, inventory (daily); danh mục (khi đổi)&lt;br&gt;• Lịch: Nhanh daily 06:00 · Shopee weekly&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color='#b85450'&gt;Hạn chế&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Rate limit API Nhanh → phân trang, retry/backoff&lt;br&gt;• Trạng thái đơn đổi muộn (hoàn 1–3 tuần) → nhiều phiên bản/đơn&lt;br&gt;• Shopee không trả SKU → cần listing map&lt;br&gt;• Crawl tuần trùng 1 ngày → dedup ở Silver&lt;br&gt;• Session Shopee hết hạn → cảnh báo" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c22"><mxGeometry x="15" y="425" width="220" height="320" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style='font-size:13px'&gt;Apache Spark 3.5 · Batch job&lt;/b&gt;&lt;br&gt;Airflow lập lịch · &lt;b&gt;①&lt;/b&gt; đọc landing → append Bronze · &lt;b&gt;②&lt;/b&gt; parse, làm sạch, dedup + MERGE → Silver" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;" vertex="1" parent="c21"><mxGeometry x="285" y="45" width="700" height="55" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style='font-size:13px'&gt;Trino 460 (SQL) + dbt-trino&lt;/b&gt;&lt;br&gt;&lt;b&gt;③&lt;/b&gt; build Gold sau mỗi lần nạp Silver · dbt test · lineage/docs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;" vertex="1" parent="c21"><mxGeometry x="1005" y="45" width="405" height="55" as="geometry"/></mxCell><mxCell id="c30" value="Bronze — Raw Data" style="swimlane;startSize=28;html=1;rounded=1;arcSize=4;fillColor=#ffe0c2;strokeColor=#c67c2e;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="c21"><mxGeometry x="285" y="115" width="330" height="500" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Object type:&lt;/b&gt; Iceberg tables&lt;br&gt;&lt;b&gt;Tables:&lt;/b&gt; 1 bảng / nguồn-entity&lt;br&gt;bronze.nhanh_orders · nhanh_products · nhanh_combos · nhanh_inventory · nhanh_inventory_bills · nhanh_categories · nhanh_brands · nhanh_depots · shopee_product_performance · shopee_reviews · manual_category · manual_product_category · manual_shopee_listing_map&lt;br&gt;&lt;br&gt;&lt;b&gt;Load:&lt;/b&gt;&lt;br&gt;• Append theo batch (Airflow)&lt;br&gt;• Idempotent theo _batch_id (nạp lại không trùng)&lt;br&gt;&lt;br&gt;&lt;b&gt;Transformations:&lt;/b&gt;&lt;br&gt;• Không đổi payload (giữ nguyên JSON gốc)&lt;br&gt;• + cột _ingested_at, _source, _entity, _batch_id&lt;br&gt;&lt;br&gt;&lt;b&gt;Partition:&lt;/b&gt; dt (ngày landing)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#e0b48a;" vertex="1" parent="c30"><mxGeometry x="12" y="40" width="306" height="445" as="geometry"/></mxCell><mxCell id="c32" value="Silver — Cleaned, Standardized" style="swimlane;startSize=28;html=1;rounded=1;arcSize=4;fillColor=#e6e6e6;strokeColor=#7a7a7a;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="c21"><mxGeometry x="635" y="115" width="350" height="500" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Object type:&lt;/b&gt; Iceberg tables&lt;br&gt;&lt;b&gt;Load:&lt;/b&gt; MERGE INTO (upsert) sau mỗi lần nạp Bronze · compaction định kỳ&lt;br&gt;&lt;br&gt;&lt;b&gt;Transformations:&lt;/b&gt;&lt;br&gt;• Parse JSON, flatten mảng (products[], models[])&lt;br&gt;• Dedup theo khóa:&lt;br&gt;&amp;nbsp;&amp;nbsp;– orders: bản updatedAt mới nhất&lt;br&gt;&amp;nbsp;&amp;nbsp;– performance: batch crawl mới nhất&lt;br&gt;&amp;nbsp;&amp;nbsp;– reviews: mtime mới nhất&lt;br&gt;• Ép kiểu; epoch → giờ VN; chuẩn hóa mã trạng thái / kênh / kho&lt;br&gt;• Tách combo → SKU con&lt;br&gt;• Che PII: hash tên, SĐT, địa chỉ&lt;br&gt;&lt;br&gt;&lt;b&gt;Entity tables:&lt;/b&gt;&lt;br&gt;orders · order_lines · products (SCD2) · combo_items · inventory_snapshot · inventory_bills · product_performance_daily · reviews · category · product_category · shopee_listing_map" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#b3b3b3;" vertex="1" parent="c32"><mxGeometry x="12" y="40" width="326" height="445" as="geometry"/></mxCell><mxCell id="c34" value="Gold — Business-Ready" style="swimlane;startSize=28;html=1;rounded=1;arcSize=4;fillColor=#fff2b3;strokeColor=#c9a600;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="c21"><mxGeometry x="1005" y="115" width="405" height="500" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Object type:&lt;/b&gt; Iceberg tables (dbt models)&lt;br&gt;&lt;b&gt;Load:&lt;/b&gt; dbt-trino incremental theo ngày · full refresh khi cần&lt;br&gt;&lt;br&gt;&lt;b&gt;Star schema&lt;/b&gt;&lt;br&gt;• Dim: dim_date · dim_product (SCD2) · dim_channel_shop · dim_depot · dim_customer · dim_location&lt;br&gt;• Fact: fct_order_line · fct_inventory_snapshot · fct_inventory_movement · fct_product_funnel · fct_review · fct_demand_forecast&lt;br&gt;&lt;br&gt;&lt;b&gt;Marts&lt;/b&gt;&lt;br&gt;sales_daily · stock_alert · order_sla · return_cancel · review_alert · channel_pnl&lt;br&gt;&lt;br&gt;&lt;b&gt;Business logic&lt;/b&gt;&lt;br&gt;• Nhu cầu ≠ doanh số (cộng lost sales khi hết hàng)&lt;br&gt;• Phân bổ tiền đơn xuống dòng; combo → SKU&lt;br&gt;• Doanh thu thuần = tiền hàng − phí sàn − hoàn/hủy" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#e0c95c;" vertex="1" parent="c34"><mxGeometry x="12" y="40" width="381" height="445" as="geometry"/></mxCell><mxCell id="c36" value="Storage" style="swimlane;startSize=26;html=1;rounded=1;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;swimlaneFillColor=#ffffff;" vertex="1" parent="c21"><mxGeometry x="285" y="630" width="1125" height="180" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b style='font-size:13px'&gt;MinIO (S3 API)&lt;/b&gt;&lt;br&gt;bucket &lt;b&gt;landing&lt;/b&gt; (JSONL.gz) · bucket &lt;b&gt;lakehouse&lt;/b&gt;&lt;br&gt;Parquet + zstd" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="c36"><mxGeometry x="20" y="40" width="330" height="115" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b style='font-size:13px'&gt;Apache Iceberg 1.6&lt;/b&gt;&lt;br&gt;ACID · MERGE INTO · time travel&lt;br&gt;schema evolution · hidden partitioning" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="c36"><mxGeometry x="395" y="40" width="330" height="115" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b style='font-size:13px'&gt;Iceberg REST Catalog&lt;/b&gt;&lt;br&gt;namespaces: bronze · silver · gold&lt;br&gt;dùng chung cho Spark &amp; Trino" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="c36"><mxGeometry x="770" y="40" width="330" height="115" as="geometry"/></mxCell><mxCell id="c40" value="③ Consume" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=15;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1780" y="70" width="300" height="830" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b style='font-size:13px'&gt;Power BI&lt;/b&gt;&lt;br&gt;Import / DirectQuery qua Trino connector (ODBC)&lt;br&gt;&lt;font color='#555555'&gt;Dashboard: doanh số kênh, tồn kho, SLA, review&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="c40"><mxGeometry x="15" y="50" width="270" height="115" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b style='font-size:13px'&gt;Mô hình dự báo nhu cầu&lt;/b&gt;&lt;br&gt;Python (Prophet / LightGBM)&lt;br&gt;Đọc Gold → train → ghi dự báo về &lt;b&gt;fct_demand_forecast&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;Batch weekly qua Airflow&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="c40"><mxGeometry x="15" y="270" width="270" height="135" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b style='font-size:13px'&gt;Trino :8090 — Ad-hoc SQL&lt;/b&gt;&lt;br&gt;DBeaver / CLI cho phân tích nhanh" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="c40"><mxGeometry x="15" y="510" width="270" height="75" as="geometry"/></mxCell><mxCell id="c44" value="④ Orchestration · Data Quality · Observability" style="swimlane;startSize=30;html=1;rounded=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=15;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="925" width="2060" height="245" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b style='font-size:13px'&gt;Apache Airflow 2.10 :8088&lt;/b&gt;&lt;br&gt;Scheduler + Web UI&lt;br&gt;Retry, SLA miss, backfill theo dt" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c44"><mxGeometry x="15" y="45" width="240" height="95" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;DAGs&lt;/b&gt;&lt;br&gt;• &lt;b&gt;nhanh_daily&lt;/b&gt; (06:00): extract → landing → bronze → silver → gold&lt;br&gt;• &lt;b&gt;shopee_weekly&lt;/b&gt; (CN 07:00): crawl performance + nạp reviews → bronze → silver → gold&lt;br&gt;• &lt;b&gt;manual_on_change&lt;/b&gt;: file Excel mới → landing → silver&lt;br&gt;• &lt;b&gt;forecast_weekly&lt;/b&gt; (T2): train + ghi fct_demand_forecast&lt;br&gt;• &lt;b&gt;iceberg_maintenance&lt;/b&gt; (daily 02:00): rewrite_data_files, expire_snapshots, remove_orphan_files" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="c44"><mxGeometry x="275" y="45" width="560" height="180" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Data Quality&lt;/b&gt; (task cuối mỗi DAG, fail → dừng)&lt;br&gt;• Đếm dòng landing ↔ bronze ↔ silver theo _batch_id&lt;br&gt;• Unique / not null khóa; FK đơn → SP, review → listing&lt;br&gt;• Tồn kho = Σ nhập − Σ xuất (đối soát phiếu kho)&lt;br&gt;• Đơn hủy không có deliveryAt; freshness ≤ 1 ngày&lt;br&gt;• dbt test cho Gold" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="c44"><mxGeometry x="855" y="45" width="450" height="180" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b style='font-size:13px'&gt;Prometheus :9090&lt;/b&gt;&lt;br&gt;statsd-exporter (Airflow), Spark metrics, MinIO metrics" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c44"><mxGeometry x="1325" y="45" width="240" height="85" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b style='font-size:13px'&gt;Grafana :3000&lt;/b&gt;&lt;br&gt;Thời lượng DAG, số dòng/batch, độ trễ dữ liệu, dung lượng lake" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c44"><mxGeometry x="1595" y="45" width="245" height="85" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b style='font-size:13px'&gt;Alerting&lt;/b&gt;&lt;br&gt;Email / Telegram khi DAG lỗi, DQ fail hoặc session Shopee hết hạn" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c44"><mxGeometry x="1325" y="145" width="515" height="80" as="geometry"/></mxCell><mxCell id="c51" value="PromQL" style="jumpStyle=arc;jumpSize=8;edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;labelBackgroundColor=default;endArrow=b