# =============================================================================
#  Mẫu file môi trường. Cách dùng:  copy .env.example .env  rồi đổi các giá trị <...>
#  File .env chứa mật khẩu thật, đã có trong .gitignore, KHÔNG commit.
# =============================================================================

COMPOSE_PROJECT_NAME=tlcn

# ---------------- MinIO (object storage, tương thích S3) ----------------
# minio/minio đã bị gỡ khỏi Docker Hub (09/2026) -> dùng bản fork tương thích Silo
MINIO_IMAGE=pgsty/silo:RELEASE.2026-09-16T00-00-00Z
MINIO_ROOT_USER=<doi-ten-dang-nhap>
MINIO_ROOT_PASSWORD=<mat-khau-it-nhat-8-ky-tu>
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------- Bucket ----------------
LANDING_BUCKET=landing
LAKEHOUSE_BUCKET=lakehouse

# ---------------- Iceberg REST Catalog ----------------
ICEBERG_REST_IMAGE=tabulario/iceberg-rest:1.6.0
ICEBERG_REST_PORT=8181
AWS_REGION=us-east-1

# ---------------- Trino ----------------
TRINO_IMAGE=trinodb/trino:460
TRINO_PORT=8090
TRINO_MEM_LIMIT=3g

# ---------------- Spark (image tự build) ----------------
# Phiên bản jar phải khớp: Spark 3.5 + Scala 2.12 -> Iceberg runtime 3.5_2.12;
# Spark 3.5.3 đi kèm Hadoop 3.3.4 -> hadoop-aws 3.3.4 -> aws-java-sdk-bundle 1.12.262
SPARK_BASE_IMAGE=apache/spark:3.5.3-scala2.12-java17-python3-ubuntu
SPARK_IMAGE=tlcn/spark:3.5.3-iceberg1.6.1
ICEBERG_VERSION=1.6.1
HADOOP_AWS_VERSION=3.3.4
AWS_SDK_BUNDLE_VERSION=1.12.262

SPARK_MASTER_UI_PORT=8081
SPARK_WORKER_UI_PORT=8082
SPARK_APP_UI_PORT=4040
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=3g
SPARK_WORKER_MEM_LIMIT=4g

# ---------------- Postgres (metadata của Airflow) ----------------
POSTGRES_IMAGE=postgres:16
POSTGRES_USER=<doi-user>
POSTGRES_PASSWORD=<doi-mat-khau>
POSTGRES_DB=airflow

# ---------------- Airflow ----------------
AIRFLOW_IMAGE=apache/airflow:2.10.3-python3.11
AIRFLOW_UID=50000
AIRFLOW_PORT=8088
AIRFLOW_ADMIN_USER=<doi-user>
AIRFLOW_ADMIN_PASSWORD=<doi-mat-khau>
AIRFLOW_SECRET_KEY=<chuoi-ngau-nhien>
# Tạo khoá: docker run --rm apache/airflow:2.10.3-python3.11 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=<fernet-key>

# ---------------- Giám sát ----------------
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
STATSD_IMAGE=prom/statsd-exporter:v0.27.1
GRAFANA_IMAGE=grafana/grafana:11.2.2
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=<doi-user>
GRAFANA_ADMIN_PASSWORD=<doi-mat-khau>

# ---------------- dbt (image tự build, chạy theo lệnh) ----------------
DBT_BASE_IMAGE=python:3.11-slim-bookworm
DBT_CORE_VERSION=1.9.8
DBT_TRINO_VERSION=1.9.3
DBT_IMAGE=tlcn/dbt-trino:1.9.3
DBT_DOCS_PORT=8085
